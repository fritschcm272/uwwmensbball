# Copy this file to parser\.env and fill in the values. .env is NOT in git (and did not survive the move to F:
# on 11/17 -- a dot-file is easy to miss), so this template is here to say what the parser looks for.
# The parser reads it from the parser folder or one folder up (01_uw_whitewater_scouting_parser.py).

# the coaches' app -- without this the scouting brief renders every app link as dead "(in the app)" text
UWW_APP_URL=https://uwwmensbball-new.streamlit.app

# FastScout -- without these the live scrape is skipped: rosters, schedules and play-by-play fall back to
# whatever local backup files are in parser\inputs
FASTSCOUT_USERNAME=fritschcm27@gmail.com
FASTSCOUT_PASSWORD=Brewers140.6x2

# Synergy -- without these any game that is not already exported or cached cannot be pulled
SYNERGY_USERNAME=fritschcm27@gmail
SYNERGY_PASSWORD=Brewers140.6x2

# optional
# AI_MODEL=
# OPENAI_BASE_URL=
# PLAYWRIGHT_BROWSERS_PATH=
